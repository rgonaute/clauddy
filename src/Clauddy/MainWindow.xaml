<Window x:Class="Clauddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Clauddy.ViewModels"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="Clauddy"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">

    <Border Background="#0d0d12" BorderBrush="Black" BorderThickness="3" Padding="8"
            Cursor="SizeAll"
            MouseLeftButtonDown="DragArea_MouseLeftButtonDown"
            MouseRightButtonUp="Root_MouseRightButtonUp">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="4" Direction="-45" Opacity="1"/>
        </Border.Effect>
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
        </Border.LayoutTransform>

        <StackPanel Width="248" Background="Transparent">

            <!-- Top: session pill bar -->
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Pill_Click" Tag="{Binding}" Margin="0,0,4,4"
                                BorderBrush="Black" BorderThickness="2" Padding="6,2"
                                FontFamily="Courier New" FontSize="10" FontWeight="Bold"
                                Foreground="White">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1f2937"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#374151"/>
                                            <Setter Property="BorderBrush" Value="#fff"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAlerting}" Value="True">
                                            <Setter Property="Background" Value="#7f1d1d"/>
                                            <Setter Property="BorderBrush" Value="#ef4444"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                         Fill="{Binding StateDot}"/>
                                <TextBlock Text="{Binding Label}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Middle: big face -->
            <Border Width="232" Height="232" Background="Black" Margin="0,2">
                <Image gif:ImageBehavior.AnimatedSource="{Binding BigGifSource}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <!-- Bottom: metrics. Primary line carries % when calibrated, raw tokens otherwise. -->
            <StackPanel Margin="0,8,0,0">
                <TextBlock FontFamily="Courier New" FontSize="13" FontWeight="Bold" Foreground="#f3f4f6" HorizontalAlignment="Center">
                    <Run Text="{Binding Window5hDisplay, Mode=OneWay}"/>
                    <Run Text="  ·  "/>
                    <Run Text="{Binding Window7dDisplay, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontFamily="Courier New" FontSize="10" Foreground="#9ca3af" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Text="{Binding SubtitleDisplay, Mode=OneWay}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
